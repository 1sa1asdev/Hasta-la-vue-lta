{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "seed": "npm run seed --workspace=api",
    "pr": "node tools/pr-builder/src/cli.js",
    "pr:test": "node --test tools/pr-builder/test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
