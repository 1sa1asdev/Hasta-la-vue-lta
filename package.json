{
  "name": "utpost",
  "private": true,
  "version": "1.4.2",
  "workspaces": [
    "shared",
    "api",
    "web",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --workspace=api\" \"npm run dev --workspace=client --port=3001\"",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:client": "npm run dev --workspace=client",
    "seed": "npm run seed --workspace=api",
    "pr": "node tools/pr-builder/src/cli.js",
    "pr:test": "node --test tools/pr-builder/test",
    "typecheck": "npm run typecheck --workspace=client",
    "lint": "npm run lint --workspace=client",
    "format:check": "npm run format:check --workspace=client",
    "test": "npm run test --workspace=client",
    "build": "npm run build --workspace=client"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "concurrently": "^9.1.2"
  }
}
